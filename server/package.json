{
  "name": "leslies-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js --production",
    "start:production": "node --env-file-if-exists=../.env src/server.js --production",
    "admin:create": "node --env-file-if-exists=../.env src/database/create-admin.js",
    "db:init": "node --env-file-if-exists=../.env src/database/init.js",
    "db:backup": "node --env-file-if-exists=../.env src/database/backup.js",
    "db:restore": "node --env-file-if-exists=../.env src/database/restore.js",
    "check": "node src/check.js && node src/database/maintenance-check.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "express": "^5.1.0"
  }
}
