# Cloud setup from the repository root: neon env pull -s postgres --file .env
# The API uses the pooled URL. Schema setup and imports prefer the direct URL.
# DATABASE_URL=postgresql://ROLE:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://ROLE:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# Vercel project setting: RESTAURANT_API_ORIGIN=<Neon function HTTPS origin>

# Local Express server
HOST=0.0.0.0
PORT=3000

# SQLite LAN installation (used when DATABASE_URL is unset)
# DATABASE_PATH=C:\ProgramData\LesliesRMS\data\restaurant.db
